# Copy to .env.local for local runs. Do not commit .env.local.

# Captcha providers
CAPSOLVER_API_KEY=

# Optional backend/debug settings
TICKET_BACKEND_BASE_URL=
TICKET_PLATFORM_CODE=livepocket

# Redis queue settings
LOTTERY_REDIS_HOST=127.0.0.1
LOTTERY_REDIS_PORT=6379
LOTTERY_REDIS_DB=0
LOTTERY_REDIS_PASSWORD=

# Optional LivePocket proxy settings
LIVEPOCKET_PROXY_ENABLED=false
LIVEPOCKET_PROXY_SCOPE=all
LIVEPOCKET_PROXY_PROVIDER=decodo
LIVEPOCKET_PROXY_REGION=JP
LIVEPOCKET_PROXY_GATEWAY=gate.decodo.com:7000
LIVEPOCKET_PROXY_USERNAME=
LIVEPOCKET_PROXY_PASSWORD=
# Set true only after Decodo confirms that livepocket.jp is approved.
LIVEPOCKET_PROXY_TARGET_APPROVED=false
LIVEPOCKET_PROXY_SESSION_MINUTES=60
LIVEPOCKET_PROXY_POOL_MIN=5
LIVEPOCKET_PROXY_BATCH_SIZE=10
LIVEPOCKET_PROXY_MAX_ATTEMPTS=3

# IPWeb compatibility settings
LIVEPOCKET_PROXY_API_TOKEN=
LIVEPOCKET_PROXY_API_URL=http://api.ipweb.cc:8004/api/agent/account2
LIVEPOCKET_PROXY_STATIC=
