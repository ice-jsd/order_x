# Copy to .env.local for local runs. Do not commit .env.local.

# Captcha providers
CAPSOLVER_API_KEY=

# Optional backend/debug settings
TICKET_BACKEND_BASE_URL=
TICKET_PLATFORM_CODE=livepocket

# Redis queue settings
LOTTERY_REDIS_HOST=127.0.0.1
LOTTERY_REDIS_PORT=6379
LOTTERY_REDIS_DB=0
LOTTERY_REDIS_PASSWORD=

# Optional LivePocket proxy settings
LIVEPOCKET_PROXY_ENABLED=false
LIVEPOCKET_PROXY_API_TOKEN=
LIVEPOCKET_PROXY_STATIC=
