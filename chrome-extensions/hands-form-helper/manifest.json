{
  "manifest_version": 3,
  "name": "表单抽票助手",
  "version": "0.1.0",
  "description": "领取表单抽票任务，直接在页面填写并提交，成功后回写后台。",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://event.hands.net/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "表单抽票助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://event.hands.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
